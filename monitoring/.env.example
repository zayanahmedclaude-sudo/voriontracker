# Vorion monitoring stack settings. setup.sh creates .env from this file and
# fills what it can automatically (see "auto" below). Wrap any value that
# contains $ in single quotes: PASSWORD='abc$123'

# ── Stack size ─────────────────────────────────────────────────────────────
# Empty = slim stack for a 2 GB VPS. Set to "full" to add Grafana and
# container metrics (needs ~400 MB more RAM).
COMPOSE_PROFILES=

# ── API metrics ────────────────────────────────────────────────────────────
# Shared secret Prometheus uses to read the API's /api/metrics.
# auto: generated when empty; setup.sh also adds it to the backend's .env.
METRICS_TOKEN=
# Backend container and port on the vorion_private Docker network.
BACKEND_TARGET=vorion-backend:3000
# The backend's .env (read for SMTP settings, updated with METRICS_TOKEN).
BACKEND_ENV=/opt/vorion-backend/.env

# ── Endpoint checks ────────────────────────────────────────────────────────
# Comma-separated public URLs probed every 30s from this VPS.
PROBE_URLS=https://api.vorionsystems.com/api/health,https://tracker.vorionsystems.com,https://live.vorionsystems.com
# Internal URLs (container to container), checked without DNS/TLS.
INTERNAL_PROBE_URLS=http://vorion-backend:3000/api/health,http://vorion-socket:4000/health

# ── Database ───────────────────────────────────────────────────────────────
# Read-only monitoring login, connecting to Postgres directly (not pgbouncer).
# auto: when empty and POSTGRES_CONTAINER is running, setup.sh creates the
# vorion_monitor role with a random password and fills this in.
POSTGRES_EXPORTER_DSN=
POSTGRES_CONTAINER=vorion-postgres

# ── Alert e-mails ──────────────────────────────────────────────────────────
# Comma-separated recipients.
ALERT_EMAIL_TO=zayan.ahmed@vorionsystems.com
# auto: when empty, copied from the backend's SMTP_HOST/PORT/USER/PASS/FROM_EMAIL.
SMTP_SMARTHOST=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Grafana (only with COMPOSE_PROFILES=full) ──────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=http://localhost:3001

# ── Docker networks the backend uses ───────────────────────────────────────
APP_NETWORK=vorion_private
EDGE_NETWORK=vorion_edge
