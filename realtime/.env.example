# Vorion realtime settings (socket server + Redis). Keep the real file as
# realtime/.env on your PC (git-ignored) and upload it to ~/vorion-realtime/.env.
# JWT_SECRET and SOCKET_SERVER_SECRET must equal the backend's values.
JWT_SECRET=
SOCKET_SERVER_SECRET=
# Letters and digits only (used inside the redis:// URL).
REDIS_PASSWORD=
# Comma-separated browser origins allowed to connect (agents send no origin).
SOCKET_CLIENT_ORIGIN=https://tracker.vorionsystems.com

SOCKET_DOMAIN=socket.vorionsystems.com
BACKEND_ENV=/opt/vorion-backend/.env
APP_NETWORK=vorion_private
