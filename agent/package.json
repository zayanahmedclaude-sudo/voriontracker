{
  "name": "vorion-tracker",
  "version": "1.0.14",
  "description": "Vorion Tracker silent background agent — captures screenshots and tracks time",
  "main": "build/main.js",
  "scripts": {
    "generate:embedded-config": "node scripts/generate-embedded-config.cjs",
    "generate:app-icon": "node scripts/generate-app-icon.cjs",
    "dev": "concurrently \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"esbuild src/capture-renderer.ts --bundle --platform=browser --format=iife --outfile=build/capture-renderer.js --watch\" \"node scripts/copy-electron-assets.cjs\" \"wait-on http://localhost:5174 && wait-on build/main.js && electron .\"",
    "compile": "npm run generate:embedded-config && npm run generate:app-icon && vite build && tsc -p tsconfig.electron.json && esbuild src/capture-renderer.ts --bundle --platform=browser --format=iife --outfile=build/capture-renderer.js && esbuild src/capture-preload.ts --bundle --platform=node --external:electron --format=cjs --outfile=build/capture-preload.js && node scripts/copy-electron-assets.cjs",
    "build": "node scripts/clean-release.cjs && npm run compile && node scripts/run-electron-builder.cjs",
    "build:win": "npm run build",
    "publish:win": "node scripts/clean-release.cjs && npm run compile && electron-builder --win --x64 --publish always",
    "pack": "node scripts/clean-release.cjs && npm run generate:embedded-config && npm run generate:app-icon && electron-builder --dir",
    "restore-electron": "node restore-electron.js"
  },
  "postinstall": "npm run restore-electron",
  "dependencies": {
    "@supabase/supabase-js": "^2.110.5",
    "@vercel/blob": "^2.6.1",
    "axios": "^1.6.8",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.4",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "form-data": "^4.0.0",
    "livekit-client": "^2.20.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^8.2.2",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.5",
    "unzipper": "^0.11.0",
    "vite": "^6.4.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.vorionsystems.vorion-tracker",
    "productName": "Vorion Tracker",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "extraMetadata": {
      "main": "build/main.js"
    },
    "files": [
      "build/**/*",
      "src/capture.html"
    ],
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "VorionTrackerSetup.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "Vorion Tracker"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "VorionDevTeam",
        "repo": "tracker-download",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true
    },
    "dmg": {
      "title": "Vorion Tracker",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Utility"
    }
  }
}
