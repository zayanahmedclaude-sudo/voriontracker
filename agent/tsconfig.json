{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "resolveJsonModule": true
  },
  "include": [
    "src/main.ts",
    "src/preload.ts",
    "src/live-watch.ts",
    "src/capture-preload.ts",
    "src/websiteBlock.ts"
  ]
}
